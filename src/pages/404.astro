---
import Layout from '../layouts/Layout.astro';

const title = "404: Page Not Found — Muhammed Salman";
const description = "The page you are looking for does not exist or has been moved.";
---

<Layout title={title} description={description}>
  <main class="error-page">
    <div class="error-card">
      <div class="section-tag" aria-hidden="true">
        <span class="tag-number">404</span>
        <span class="tag-divider">/</span>
        <span class="tag-label">ERROR</span>
      </div>

      <h1 class="error-title">LOST IN THE NOISE.</h1>
      <p class="error-message">
        The page you are looking for does not exist or has been moved.
      </p>

      <div class="error-action">
        <a href="/" class="home-btn" aria-label="Return to home page">
          ← BACK TO HOME
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    background-color: var(--bg-primary);
  }

  .error-card {
    max-width: 640px;
    width: 100%;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .tag-number {
    color: var(--text-secondary);
  }

  .tag-divider {
    color: var(--border-focus);
  }

  .error-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .error-message {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .error-action {
    display: flex;
  }

  .home-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    background-color: var(--accent-badge);
    color: var(--badge-text);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .home-btn:hover {
    background-color: #ffffff;
    transform: translateY(-2px);
  }
</style>
