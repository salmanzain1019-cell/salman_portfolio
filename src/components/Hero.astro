---
// src/components/Hero.astro
interface Props {
  taglinePrimary?: string;
  taglineSecondary?: string;
  edition?: string;
  displayTitle?: string;
  videoSrc?: string;
  posterSrc?: string;
}

const {
  taglinePrimary = "CREATIVE BY NATURE. STRATEGIC BY MIND.",
  taglineSecondary = "Creatives? Yeah, that's his thing.",
  edition = "2026 EDITION",
  displayTitle = "CREATIVE STRATEGIST",
  videoSrc = "/assets/video/home_video.mp4",
  posterSrc = "/assets/my_images/myimg_2.png",
} = Astro.props;
---

<section id="hero" class="hero-section" aria-label="Hero Introduction">
  <!-- Video Background with Poster Fallback -->
  <div class="video-container">
    <video
      id="hero-video"
      class="hero-video"
      src={videoSrc}
      poster={posterSrc}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Studio turnaround video portrait of Muhammed Salman"
    ></video>
    <div class="video-overlay" aria-hidden="true"></div>
  </div>

  <!-- Content Layer -->
  <div class="hero-content">
    <div class="hero-meta">
      <span class="edition-pill">{edition} • {displayTitle}</span>
    </div>

    <h1 class="hero-title">
      <span class="title-line">CREATIVE BY NATURE.</span>
      <span class="title-line">STRATEGIC BY MIND.</span>
    </h1>

    <div class="hero-bottom">
      <p class="hero-subtitle">
        "{taglineSecondary}"
      </p>

      <a href="#about" class="scroll-indicator" aria-label="Scroll to about section">
        <span class="scroll-text">SCROLL TO EXPLORE</span>
        <svg class="scroll-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Hero Controls (Sound Toggle & Play/Pause for accessibility) -->
  <div class="hero-controls">
    <button
      id="play-pause-btn"
      class="control-btn"
      type="button"
      aria-label="Pause background video"
      title="Pause / Play Video"
    >
      <svg id="icon-pause" class="control-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
      <svg id="icon-play" class="control-icon" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </button>

    <button
      id="sound-toggle-btn"
      class="control-btn"
      type="button"
      aria-label="Unmute audio"
      title="Toggle Audio"
    >
      <svg id="icon-muted" class="control-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <line x1="23" y1="9" x2="17" y2="15"></line>
        <line x1="17" y1="9" x2="23" y2="15"></line>
      </svg>
      <svg id="icon-unmuted" class="control-icon" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const playPauseBtn = document.getElementById('play-pause-btn');
  const soundToggleBtn = document.getElementById('sound-toggle-btn');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');

  if (video) {
    // Respect prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const handleMotionPreference = (mediaQuery: MediaQueryList | MediaQueryListEvent) => {
      if (mediaQuery.matches) {
        video.pause();
        video.removeAttribute('autoplay');
        if (iconPlay && iconPause) {
          iconPlay.style.display = 'block';
          iconPause.style.display = 'none';
        }
        playPauseBtn?.setAttribute('aria-label', 'Play background video');
      } else {
        video.play().catch(() => {
          // Autoplay policy prevented playback
        });
      }
    };

    handleMotionPreference(prefersReducedMotion);
    prefersReducedMotion.addEventListener('change', handleMotionPreference);

    // Play / Pause Toggle
    playPauseBtn?.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        if (iconPlay && iconPause) {
          iconPlay.style.display = 'none';
          iconPause.style.display = 'block';
        }
        playPauseBtn.setAttribute('aria-label', 'Pause background video');
      } else {
        video.pause();
        if (iconPlay && iconPause) {
          iconPlay.style.display = 'block';
          iconPause.style.display = 'none';
        }
        playPauseBtn.setAttribute('aria-label', 'Play background video');
      }
    });

    // Sound / Mute Toggle
    soundToggleBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      if (video.muted) {
        if (iconMuted && iconUnmuted) {
          iconMuted.style.display = 'block';
          iconUnmuted.style.display = 'none';
        }
        soundToggleBtn.setAttribute('aria-label', 'Unmute audio');
      } else {
        if (iconMuted && iconUnmuted) {
          iconMuted.style.display = 'none';
          iconUnmuted.style.display = 'block';
        }
        soundToggleBtn.setAttribute('aria-label', 'Mute audio');
      }
    });
  }
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(6rem, 12vh, 8rem) clamp(1.5rem, 5vw, 4rem) 3.5rem;
    overflow: hidden;
    background-color: var(--bg-primary);
  }

  /* Fullscreen Video Background */
  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.98) contrast(1.02);
    transition: opacity 0.5s ease;
  }

  /* Radial & Bottom Fade Gradient Overlay (Lightened for video clarity) */
  .video-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 40%, rgba(10, 10, 11, 0) 30%, rgba(10, 10, 11, 0.35) 85%),
      linear-gradient(to bottom, rgba(10, 10, 11, 0.3) 0%, rgba(10, 10, 11, 0) 25%, rgba(10, 10, 11, 0.15) 60%, rgba(10, 10, 11, 0.7) 90%, #0A0A0B 100%);
    pointer-events: none;
  }

  /* Content Overlay */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    pointer-events: none;
  }

  .hero-meta {
    display: flex;
    align-items: center;
  }

  .edition-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    background: rgba(18, 18, 20, 0.7);
    border: 1px solid var(--border-subtle);
    backdrop-filter: blur(10px);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 4.4vw, 4.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0;
  }

  .title-line {
    display: block;
    white-space: nowrap;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    padding-right: 7.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 400;
    color: var(--text-secondary);
    max-width: 500px;
    line-height: 1.5;
  }

  .scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    pointer-events: auto;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .scroll-indicator:hover {
    color: var(--text-primary);
    transform: translateY(2px);
  }

  .scroll-arrow {
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(4px); }
    60% { transform: translateY(2px); }
  }

  /* Floating Media Controls */
  .hero-controls {
    position: absolute;
    bottom: 2rem;
    right: clamp(1.5rem, 5vw, 4rem);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .control-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-glass);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .control-btn:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border-color: var(--border-focus);
    transform: scale(1.05);
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding-right: 5.5rem;
    }

    .hero-controls {
      bottom: 1.25rem;
      right: 1.25rem;
    }
  }
</style>
